{
   "action": {
      "default_icon": {
         "128": "resources/icon128.png",
         "16": "resources/icon16.png",
         "48": "resources/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "backend/fast/fast-main.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "all_frames": false,
      "js": [ "config.js", "backend/fast/fast-bridge.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start",
      "world": "ISOLATED"
   }, {
      "js": [ "backend/audio/freeverb-new.js", "backend/content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_end"
   } ],
   "default_locale": "en",
   "description": "Pitch shifter, speed controller & reverb for any video or audio. Includes slowed+reverb, nightcore presets & an encouragement crab!",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "resources/icon128.png",
      "16": "resources/icon16.png",
      "48": "resources/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Vibes - Pitch Changer, Speed Controls, & Reverb",
   "permissions": [ "activeTab", "scripting", "storage", "tabCapture", "offscreen" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.9",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "backend/audio/audio-config.js", "backend/audio/freeverb-processor.js", "backend/audio/jungle.js", "lang/languages.json", "lang/*/ui.json", "lang/*/quotes.json", "lang/*/premium/*.json" ]
   } ]
}
